# ---- Backend (all optional; defaults shown) ----
RPC_URL=http://127.0.0.1:8545
DEPLOYMENT_FILE=contracts/deployments/localhost.json   # written by `npm run deploy`
IPFS_API_URL=http://127.0.0.1:5001                     # Kubo RPC API
ALLOW_LOCAL_STORE_FALLBACK=true                        # DEV ONLY: local content-addressed store if IPFS is down
LOCAL_STORE_DIR=backend/.local_store
MAX_UPLOAD_MB=512
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Frontend ----
VITE_API_TARGET=http://127.0.0.1:8000

